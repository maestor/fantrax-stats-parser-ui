{
  "name": "fantrax-stats-parser-ui",
  "version": "1.0.0",
  "description": "Fantrax stats parser UI by Angular",
  "repository": "git@github.com:maestor/fantrax-stats-parser-ui.git",
  "author": "Kalle Haavisto <maestori@gmail.com>",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 ng build --configuration production",
    "audit:styles:dead": "node scripts/audit-dead-style-selectors.mjs",
    "perf:audit": "npm run build && npx tsx scripts/perf-audit.ts",
    "generate:types": "npx --yes openapi-typescript@7.13.0 https://ffhl-stats-api.vercel.app/openapi.json -o src/app/services/api.types.generated.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --coverage --watch=false",
    "lint": "eslint src --ext .ts --ignore-pattern '*.spec.ts'",
    "verify": "npm run lint && npm run test:coverage && npm run build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:mobile": "playwright test e2e/specs/mobile.spec.ts",
    "e2e:smoke": "playwright test e2e/specs/smoke.spec.ts",
    "e2e:capture-fixtures": "npx tsx e2e/scripts/capture-fixtures.ts"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.7",
    "@angular/cdk": "22.0.5",
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/material": "22.0.5",
    "@angular/platform-browser": "22.0.7",
    "@angular/platform-browser-dynamic": "22.0.7",
    "@angular/platform-server": "22.0.7",
    "@angular/router": "22.0.7",
    "@angular/service-worker": "22.0.7",
    "@angular/ssr": "22.0.7",
    "@fontsource/roboto": "^5.3.0",
    "@fortawesome/angular-fontawesome": "5.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "chart.js": "^4.5.1",
    "material-icons": "^1.13.14",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.13.4",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "@vitest/coverage-istanbul": "^4.1.8",
    "eslint": "^10.10.0",
    "jsdom": "^28.1.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.8",
    "vitest-canvas-mock": "^1.2.0"
  }
}
